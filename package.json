{
  "name": "evfx-collection-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "preview": "node scripts/serve.mjs",
    "refresh": "node scripts/refresh.mjs",
    "publish": "node scripts/publish.mjs",
    "discover": "node scripts/discover.mjs",
    "sync": "node scripts/auto-sync.mjs --once --force",
    "sync:install-build-hooks": "node scripts/install-build-hooks.mjs",
    "sync:remove-build-hooks": "node scripts/install-build-hooks.mjs --uninstall",
    "auto-sync:status": "node scripts/auto-sync.mjs --status",
    "auto-sync:uninstall": "node scripts/install-auto-sync.mjs --uninstall",
    "sync-warnings": "node scripts/sync-warnings.mjs"
  }
}
