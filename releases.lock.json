    "history": [
      {
        "version": "1.1.1",
        "tag": "smart-denoise-v1.1.1-1b5dbcde40",
        "releaseUrl": "https://github.com/sbilogic/evfx/releases/tag/smart-denoise-v1.1.1-1b5dbcde40",
        "publishedAt": "2026-11-13T06:49:30Z",
        "uploaded": true,
        "prerelease": true,
        "notes": [
          "Coarse grain and blotchy color noise are now removed instead of being left behind once fine grain is gone. UI, parameter IDs, match name, saved profiles and defaults are unchanged; saved projects render with the updated engine.",
          "Each level replaces only the low band of the finer result, so fine detail still comes from full resolution."
        ]
      },
      {
        "version": "1.1.0",
        "tag": "smart-denoise-v1.1.0-ea841c685a",
        "releaseUrl": "https://github.com/sbilogic/evfx/releases/tag/smart-denoise-v1.1.0-ea841c685a",
        "publishedAt": "2026-11-04T23:09:43Z",
        "uploaded": true,
        "prerelease": true,
        "notes": [
          "Improves temporal denoising on moving footage with subpixel motion estimation and more accurate noise analysis."
        ]
      },
      {
        "version": "1.0.3",
        "tag": "smart-denoise-v1.0.3-9668cc0409",
        "releaseUrl": "https://github.com/sbilogic/evfx/releases/tag/smart-denoise-v1.0.3-9668cc0409",
        "publishedAt": "2026-11-04T18:58:55Z",
        "uploaded": true,
        "prerelease": true,
        "notes": [
          "Rejects mismatched temporal samples and prevents nonfinite values from contaminating output.",
          "Corrects handling of cropped and offset After Effects buffers."
        ]
      }
    ]
  },
